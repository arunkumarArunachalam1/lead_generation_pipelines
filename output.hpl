, reviewer_verified
, reviewer_industry
, reviewer_client_size_min
, reviewer_client_size_max
, reviewer_review_type
, reviewer_state
, reviewer_country
, "source"
, is_filtered_for_email
, filtered_for_email_at
FROM master.master_table
where filtered_for_email_at Is Null
Order by company ASC
Limit 100
</sql>
